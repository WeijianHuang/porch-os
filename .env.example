# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 忽略，绝不提交。
# 本文件只放占位值，不含任何真实密钥。
# 数据库为 PostgreSQL 18.7（ADR-0001），后端为 Go（ADR-0002）。

# R0 引导程序：只提供 /health，不连接数据库
PORT=8080
LOG_LEVEL=info

# 业务基准时区（ADR-0004）：固定东八区，不按门店或请求覆盖；启动时校验。
# 时间仍以 timestamptz / ISO 8601 UTC 存储与传输，此值只用于展示与业务日换算。
APP_TIMEZONE=Asia/Shanghai

# 审计日志保留天数（ADR-0007）：默认 30 天，全局生效、启动时校验，不通过 API 或按店覆盖。
# 仅适用于 audit_logs 这类运行期数据；业务单据与流水不设任何保留窗口，也不归档。
# 默认 30、取值范围 1..3650、不允许关闭清理、不可按店覆盖、变更需重启（ADR-0008）；
# 窗口按 UTC+8 自然日计算，细则见 docs/design/08-audit-retention.md。
AUDIT_LOG_RETENTION_DAYS=30

# 本地 PostgreSQL：docker compose 读取以下四项
PORCH_PG_PORT=5432
POSTGRES_USER=porch
POSTGRES_PASSWORD=change-me-to-a-random-value
POSTGRES_DB=porch

# R1 起的应用进程使用；密码须与上面保持一致
# 连接池按 Docker 2+2 预算配置（advisor 20 / worker 10 / job 5 + 预留 15 = 80 <= 100）
API_MAX_CONNS=20
WORKER_MAX_CONNS=10
DB_MAX_CONNS=20
# /ready 校验 goose 版本；本地执行完 cmd/job migrate 后填最新版本号（当前为 10）
EXPECTED_SCHEMA_VERSION=10
# 至少 32 字节；生产环境由 Secret 注入，绝不提交真实值
JWT_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://porch:change-me-to-a-random-value@localhost:5432/porch?sslmode=disable

# 仅本地开发：cmd/job seed-user 从这里读取，不写入代码库
# SEED_LOGIN=admin
# SEED_PASSWORD=<至少 8 字节的本地口令>
