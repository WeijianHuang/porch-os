# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 忽略，绝不提交。
# 本文件只放占位值，不含任何真实密钥。
# 数据库已选定 PostgreSQL 18.7；其余技术栈确定后再按实际配置项补充。

PORT=8080
LOG_LEVEL=info

# 本地 PostgreSQL：docker compose 读取以下四项
PORCH_PG_PORT=5432
POSTGRES_USER=porch
POSTGRES_PASSWORD=change-me-to-a-random-value
POSTGRES_DB=porch

# 未来应用进程使用；密码须与上面保持一致
DATABASE_URL=postgresql://porch:change-me-to-a-random-value@localhost:5432/porch?sslmode=disable
