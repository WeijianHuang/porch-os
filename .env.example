# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 忽略，绝不提交。
# 本文件只放占位值，不含任何真实密钥。
# 数据库为 PostgreSQL 18.7（ADR-0001），后端为 Go（ADR-0002）。

# R0 引导程序：只提供 /health，不连接数据库
PORT=8080
LOG_LEVEL=info

# 业务基准时区（ADR-0004）：固定东八区，不按门店或请求覆盖；启动时校验。
# 时间仍以 timestamptz / ISO 8601 UTC 存储与传输，此值只用于展示与业务日换算。
APP_TIMEZONE=Asia/Shanghai

# 审计日志保留天数（ADR-0007）：默认 30 天，全局生效、启动时校验，不通过 API 或按店覆盖。
# 仅适用于 audit_logs 这类运行期数据；业务单据与流水不设任何保留窗口，也不归档。
# 取值范围 / 是否可关闭清理等细则尚未冻结，见 docs/design/00-overview.md 第 8.2 节 NQ-10。
AUDIT_LOG_RETENTION_DAYS=30

# 本地 PostgreSQL：docker compose 读取以下四项
PORCH_PG_PORT=5432
POSTGRES_USER=porch
POSTGRES_PASSWORD=change-me-to-a-random-value
POSTGRES_DB=porch

# R1 起的应用进程使用；密码须与上面保持一致
DATABASE_URL=postgresql://porch:change-me-to-a-random-value@localhost:5432/porch?sslmode=disable
